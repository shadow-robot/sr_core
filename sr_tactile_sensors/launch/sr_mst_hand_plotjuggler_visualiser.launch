<launch>
  <!-- Hand and sensor configurations-->
  <arg name="hand_id" default="rh"/>

  <node name="$(arg hand_id)_MST_plotjuggler_visualiser" pkg="plotjuggler" type="plotjuggler" args="--layout $(find sr_mst)/config/hand_plotjuggler_config_$(arg hand_id).xml"/>

</launch>